SECRET_KEY=change-me-to-a-long-random-value-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Frontend URL used to build password-reset email links (the React app, not this API)
FRONTEND_URL=http://localhost:5173

# Password reset email — leave EMAIL_HOST_USER blank to use Django's console
# backend (prints emails to this server's log) for local dev/demos. Set both
# to send real emails via SMTP (example values below are for Gmail with an
# App Password: https://myaccount.google.com/apppasswords).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Gullak <no-reply@gullak.app>
# How long a reset link stays valid, in seconds (default: 3600 = 1 hour)
PASSWORD_RESET_TIMEOUT=3600
