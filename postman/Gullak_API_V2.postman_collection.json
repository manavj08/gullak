							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/wallet/transactions/transfer/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"from_account\": {{account_id}},\n  \"to_account\": {{account_id}},\n  \"amount\": \"10.00\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "Wallet - Gullak Summary",
			"item": [
				{
					"name": "Get Gullak Total, Allocated, Unallocated & Net Worth",
