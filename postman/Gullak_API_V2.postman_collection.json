{
	"info": {
		"name": "Gullak API V2",
		"description": "Ready-to-test collection for the Gullak backend. Set base_url and login first \u2014 access/refresh tokens auto-save to collection variables. All amounts are decimal rupee strings, e.g. \"150.50\". V2 adds Shared/Group Accounts, Invites, Notifications, and the Smart Split Suggestion (see the \"Social - ...\" folders below). Run \"Auth > Login\" first, then \"Social - Setup\" requests use a second demo user (demo2) for the invite/accept flow \u2014 register or log them in via a second collection run, or swap credentials manually.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api"
		},
		{
			"key": "access_token",
			"value": ""
		},
		{
			"key": "refresh_token",
			"value": ""
		},
		{
			"key": "account_id",
			"value": ""
		},
		{
			"key": "gullak_account_id",
			"value": ""
		},
		{
			"key": "goal_id",
			"value": ""
		},
		{
			"key": "pending_deduction_id",
			"value": ""
		},
		{
			"key": "shared_account_id",
			"value": ""
		},
		{
			"key": "invite_id",
			"value": ""
		},
		{
			"key": "admin_transfer_id",
			"value": ""
		},
		{
			"key": "expense_id",
			"value": ""
		},
		{
			"key": "settlement_id",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/register/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"+919812340000\",\n  \"password\": \"StrongPass123!\"\n}"
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const data = pm.response.json();",
									"if (data.access) pm.collectionVariables.set('access_token', data.access);",
									"if (data.refresh) pm.collectionVariables.set('refresh_token', data.refresh);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/login/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo@gullak.app\",\n  \"password\": \"Demo@12345\"\n}"
						}
					}
				},
				{
					"name": "Login - Wrong Password (Error Case)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/login/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo@gullak.app\",\n  \"password\": \"WrongPassword\"\n}"
						}
					}
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const data = pm.response.json();",
									"if (data.access) pm.collectionVariables.set('access_token', data.access);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/login/refresh/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
						}
					}
				},
				{
					"name": "Get Current User (Me)",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/auth/me/"
					}
				},
				{
					"name": "Set MPIN",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/mpin/set/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mpin\": \"1234\"\n}"
						}
					}
				},
				{
					"name": "Verify MPIN",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/mpin/verify/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mpin\": \"1234\"\n}"
						}
					}
				},
				{
					"name": "Change Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/password/change/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"old_password\": \"Demo@12345\",\n  \"new_password\": \"NewPass123!\"\n}"
						}
					}
				},
				{
					"name": "Request Password Reset",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/password/reset/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo@gullak.app\"\n}"
						}
					}
				},
				{
					"name": "Confirm Password Reset",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/password/reset/confirm/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"uid\": \"PASTE_FROM_EMAIL_OR_CONSOLE_LOG\",\n  \"token\": \"PASTE_FROM_EMAIL_OR_CONSOLE_LOG\",\n  \"new_password\": \"NewStrongPass123!\"\n}"
						},
						"description": "The reset link is emailed (real SMTP if configured, otherwise printed to the backend server's console log) -- copy the uid/token out of the /reset-password?uid=...&token=... link and paste them here. Never returned in the Request Password Reset response itself."
					}
				},
				{
					"name": "Logout (Blacklist Refresh Token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/auth/logout/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "Wallet - Accounts",
			"item": [
				{
					"name": "List Accounts (includes auto-created Gullak)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const data = pm.response.json();",
									"const results = data.results || data;",
									"const nonGullak = results.find(a => a.category !== 'gullak');",
									"const gullak = results.find(a => a.category === 'gullak');",
									"if (nonGullak) pm.collectionVariables.set('account_id', nonGullak.id);",
									"if (gullak) pm.collectionVariables.set('gullak_account_id', gullak.id);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{base_url}}/wallet/accounts/"
					}
				},
				{
					"name": "Create Account (Daily Transaction)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/wallet/accounts/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test UPI\",\n  \"category\": \"daily_transaction\",\n  \"account_type\": \"UPI\",\n  \"unblock_balance\": \"1000.00\",\n  \"block_balance\": \"0.00\"\n}"
						}
					}
				},
				{
					"name": "Create Account - Gullak Rejected (Error Case)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/wallet/accounts/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Fake Gullak\",\n  \"category\": \"gullak\",\n  \"account_type\": \"\"\n}"
						}
					}
				},
				{
					"name": "Get Account Detail",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/wallet/accounts/{{account_id}}/"
					}
				},
				{
					"name": "Get Gullak Account Detail",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/wallet/accounts/{{gullak_account_id}}/"
					}
				},
				{
					"name": "Block Funds (into Gullak)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/wallet/accounts/{{account_id}}/block/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": \"50.00\",\n  \"client_request_id\": \"postman-block-001\"\n}"
						}
					}
				},
				{
					"name": "Block Funds - Over Balance (Error Case)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/wallet/accounts/{{account_id}}/block/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": \"999999.00\"\n}"
						}
					}
				},
				{
					"name": "Emergency Unblock (from Gullak)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{base_url}}/wallet/accounts/{{account_id}}/emergency-unblock/",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": \"20.00\",\n  \"client_request_id\": \"postman-unblock-001\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "Wallet - Transactions",
